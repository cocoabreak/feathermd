{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-read-file",
    "allow-save-text-export",
    "allow-save-binary-export",
    "allow-load-app-state",
    "allow-save-app-state",
    "allow-begin-link-graph-window-context-session",
    "allow-close-link-graph-window",
    "allow-open-link-graph-window",
    "allow-update-link-graph-window-context",
    "allow-read-custom-css",
    "allow-read-directory",
    "allow-authorize-path",
    "allow-authorize-archive-path",
    "allow-authorize-folder-path",
    "allow-authorize-dev-path",
    "allow-pick-markdown-file",
    "allow-pick-folder",
    "allow-pick-zip-file",
    "allow-pick-custom-css",
    "allow-pick-external-editor",
    "allow-authorize-external-editor",
    "allow-clear-external-editor",
    "allow-is-path-allowed",
    "allow-read-image-data-url",
    "allow-open-in-editor",
    "allow-pick-local-font",
    "allow-get-local-font-status",
    "allow-read-local-font",
    "allow-read-local-font-candidate",
    "allow-commit-local-font-candidate",
    "allow-discard-local-font-candidate",
    "allow-remove-local-font",
    "allow-stat-path",
    "allow-watch-path",
    "allow-unwatch-path",
    "allow-watch-directory",
    "allow-unwatch-directory",
    "allow-reconcile-directory-watches",
    "allow-watch-custom-css",
    "allow-unwatch-custom-css",
    "allow-is-fresh-launch",
    "allow-get-cli-args",
    "allow-get-shell-integration-status",
    "allow-set-shell-integration-enabled",
    "allow-search-in-directory",
    "allow-resolve-wiki-links",
    "allow-register-native-source",
    "allow-register-native-document-source",
    "allow-register-zip-source",
    "allow-reload-zip-source",
    "allow-unregister-source",
    "allow-list-source-entries",
    "allow-list-source-markdown-documents",
    "allow-read-source-link-preview",
    "allow-read-source-markdown",
    "allow-read-source-image",
    "allow-search-source",
    "allow-resolve-source-wiki-links",
    "allow-list-source-backlinks",
    "allow-get-source-link-context",
    "allow-get-source-reference-validation",
    "allow-check-for-updates",
    "allow-set-native-theme",
    "allow-set-menu-language",
    "allow-show-app-menu",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    "dialog:default"
  ]
}
